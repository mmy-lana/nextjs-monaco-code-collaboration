# Comma-separated list of signaling servers. Leave this unset unless you run
# your own rendezvous server: with no value the app derives the URL from the host
# the page was served on (`ws://<that-host>:4444`), which is what lets a device
# reached over the LAN find the machine hosting the dev server.
#
# Pinning `localhost` here breaks every peer except the one running the server,
# because each peer would resolve `localhost` to itself.
# NEXT_PUBLIC_DEFAULT_SIGNALING_SERVER=ws://192.168.1.2:4444

NEXT_PUBLIC_DEFAULT_ROOM_ID=collab-workspace-lan